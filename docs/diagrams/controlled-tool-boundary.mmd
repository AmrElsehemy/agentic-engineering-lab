flowchart LR
    U[User goal] --> M[Microsoft Foundry model]
    M -->|structured tool call| G{Application control gate}
    G -->|allowlisted + bounded + valid| T[Controlled tool]
    G -->|unknown / invalid / unsafe| R[Reject or human review]
    T --> H[Tool result]
    H --> M2[Final model response]
    M2 --> Q[Deterministic quality check]
    Q -->|pass| O[Structured execution evidence]
    Q -->|fail closed| F[Quality failure]
    M --> O
    T --> O
    M2 --> O

    classDef model fill:#0078D4,color:#fff,stroke:#005A9E,stroke-width:2px;
    classDef gate fill:#F59E0B,color:#111827,stroke:#B45309,stroke-width:2px;
    classDef safe fill:#0F766E,color:#fff,stroke:#115E59,stroke-width:2px;
    classDef fail fill:#B91C1C,color:#fff,stroke:#7F1D1D,stroke-width:2px;
    class M,M2 model;
    class G gate;
    class T,H,Q,O safe;
    class R,F fail;
