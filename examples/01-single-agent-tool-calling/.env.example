# Recommended: Microsoft Foundry project endpoint with Microsoft Entra ID.
# Format: https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
FOUNDRY_MODEL=your-deployment-name

# Optional prototype-only fallback. Do not use API keys for production evidence.
# FOUNDRY_OPENAI_BASE_URL=https://your-resource.openai.azure.com/openai/v1/
# FOUNDRY_API_KEY=replace-me
